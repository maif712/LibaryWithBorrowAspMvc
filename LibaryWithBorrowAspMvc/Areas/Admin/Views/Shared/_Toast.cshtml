@using Domain.Common

@{
    // You can pass TempData["ToastMessage"] and TempData["ToastType"] from controller
    var message = TempData[StaticMessage.TOAST_MESSAGE] as string;
    var type = TempData[StaticMessage.TOAST_TYPE] as string ?? "info"; // success, error, warning, info
    var bgClass = type switch
    {
        StaticMessage.SUCCESS => "bg-success text-white",
        StaticMessage.ERROR => "bg-danger text-white",
        StaticMessage.WARNING => "bg-warning text-dark",
        _         => "bg-info text-white"
    };
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast align-items-center @bgClass border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-bold">
                    @message
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
