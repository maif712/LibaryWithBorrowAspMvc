@model BookManagementViewModel

@{
    ViewData["Title"] = "Book Management";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📚 Book Management</h2>

        <!-- Create Book Button -->
        <a asp-action="Create" class="btn btn-gradient-primary btn-lg shadow-sm d-inline-flex align-items-center">
            <i class="bi bi-plus-circle me-2"></i> Create Book
        </a>
    </div>

    <!-- Order By Filter -->
    <div class="d-flex justify-content-end mb-3">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <label for="orderBy" class="form-label fw-bold mb-0">Order By:</label>
            <select id="orderBy" name="orderBy" class="form-select shadow-sm" style="width:200px;">
                <option value="Title">Title</option>
                <option value="CreatedAt">Created At</option>
                <option value="Category">Category</option>
                <option value="IsBorrowed">Borrowed Status</option>
            </select>

            <select id="direction" name="descending" class="form-select">
                <option value="false" selected="@(Model.Filter.Descending == false)">Ascending ↑</option>
                <option value="true" selected="@(Model.Filter.Descending == true)">Descending ↓</option>
            </select>

            <select id="pageSize" name="pageSize" class="form-select">
                <option value="10" selected=@(Model.Filter.PageSize == 10)>10</option>
                <option value="20" selected=@(Model.Filter.PageSize == 20)>20</option>
                <option value="50" selected=@(Model.Filter.PageSize == 50)>50</option>
            </select>

            <button type="submit" class="btn btn-outline-primary d-flex align-items-center">
                <i class="bi bi-funnel me-1"></i> Apply
            </button>
        </form>
    </div>

    <!-- Book Table -->
    <table class="table table-hover align-middle shadow-sm bg-white rounded">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Description</th>
                <th>Category</th>
                <th>Borrowed</th>
                <th>Created At</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Books.Items.Select((book, index) => new { book, index }))
            {
                <tr>
                    <td>@(item.index + 1)</td>
                    <td class="fw-bold">@item.book.Title</td>
                    <td>@item.book.Description</td>
                    <td><span class="badge bg-info">@item.book.CategoryName</span></td>
                    <td>
                        <span class="badge @(item.book.IsBorrowed ? "bg-danger" : "bg-success")">
                            @(item.book.IsBorrowed ? "Borrowed" : "Available")
                        </span>
                    </td>
                    <td><i class="bi bi-calendar-event me-1"></i>@item.book.CreateAtByAdmin.ToString("MMM dd, yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.book.Id" class="btn btn-sm btn-outline-primary me-2">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.book.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Are you sure you want to delete this book?');">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }

        </tbody>
    </table>

    <!-- Pagination -->
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Books.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Books.Page - 1)" asp-route-descending="@Model.Filter.Descending" asp-route-pageSize="@Model.Filter.PageSize">Previous</a>
            </li>

            @{
                int startPage = Math.Max(1, Model.Books.Page - 2);
                int endPage = Math.Min(Model.Books.TotalPages, Model.Books.Page + 2);

                if (startPage > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1" asp-route-descending="@Model.Filter.Descending" asp-route-pageSize="@Model.Filter.PageSize">1</a></li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.Books.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-descending="@Model.Filter.Descending" asp-route-pageSize="@Model.Filter.PageSize">@i</a>
                    </li>
                }

                if (endPage < Model.Books.TotalPages)
                {
                    if (endPage < Model.Books.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@Model.Books.TotalPages" asp-route-descending="@Model.Filter.Descending" asp-route-pageSize="@Model.Filter.PageSize">@Model.Books.TotalPages</a></li>
                }
            }

            <li class="page-item @(Model.Books.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Books.Page + 1)" asp-route-descending="@Model.Filter.Descending" asp-route-pageSize="@Model.Filter.PageSize">Next</a>
            </li>
        </ul>
    </nav>
</div>
